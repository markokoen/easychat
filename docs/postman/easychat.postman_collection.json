{
  "info": {
    "_postman_id": "2f7e6fcb-8f6d-4a5d-9d3a-8a0cc74f84f2",
    "name": "EasyChat API",
    "description": "Postman collection for EasyChat REST endpoints plus WebSocket endpoint reference.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"displayName\": \"{{userDisplayName}}\",\n  \"metadata\": {\n    \"source\": \"postman\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Logs in and stores token + userId into collection variables."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "var json = pm.response.json();",
                  "if (json.token) {",
                  "  pm.collectionVariables.set('token', json.token);",
                  "}",
                  "if (json.user && json.user.id) {",
                  "  pm.collectionVariables.set('userId', json.user.id);",
                  "}",
                  "if (json.user && json.user.displayName) {",
                  "  pm.collectionVariables.set('userDisplayName', json.user.displayName);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "ChatRooms",
      "item": [
        {
          "name": "Create ChatRoom",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reference\": \"pm-room-{{$timestamp}}\",\n  \"users\": [\n    {\n      \"id\": \"{{userId}}\",\n      \"displayName\": \"{{userDisplayName}}\"\n    },\n    {\n      \"id\": \"{{peerUserId}}\",\n      \"displayName\": \"{{peerDisplayName}}\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/chatrooms",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "chatrooms"
              ]
            },
            "description": "Creates a chatroom and stores chatRoomId/reference variables."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "var json = pm.response.json();",
                  "if (json.id) {",
                  "  pm.collectionVariables.set('chatRoomId', json.id);",
                  "}",
                  "if (json.reference) {",
                  "  pm.collectionVariables.set('chatRoomReference', json.reference);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get ChatRoom By ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/chatrooms/{{chatRoomId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "chatrooms",
                "{{chatRoomId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get ChatRoom By Reference",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/chatrooms/reference/{{chatRoomReference}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "chatrooms",
                "reference",
                "{{chatRoomReference}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "wsBaseUrl",
      "value": "ws://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "userDisplayName",
      "value": "Postman User"
    },
    {
      "key": "peerUserId",
      "value": "peer-user-1"
    },
    {
      "key": "peerDisplayName",
      "value": "Peer User"
    },
    {
      "key": "chatRoomId",
      "value": ""
    },
    {
      "key": "chatRoomReference",
      "value": ""
    }
  ]
}
